# ==============================================================================
# .dockerignore - Project-Specific Docker Exclusion Rules
# Only production runtime files are included in the container image.
# ==============================================================================

# Git & Version Control
.git
.gitignore
.gitattributes
.github

# Environment Secrets (Injected at runtime via Cloud Run / Docker Compose)
.env
.env.example
*.pem
*.key

# Local Virtual Environments
.venv
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Offline Test Suites & Benchmark Evaluation Harness (not needed in production)
tests/
eval/
.pytest_cache/
.coverage
htmlcov/

# Dataset Synthesis Code & Raw Exports (only data/ and code/backend.py are needed)
arabic_support_dataset/code/generator.py
arabic_support_dataset/code/templates.py
arabic_support_dataset/code/policies.py
arabic_support_dataset/code/catalog.py
arabic_support_dataset/code/validate.py
arabic_support_dataset/data/tickets_flat.csv

# Large Archives & Temp Scratch Files
*.zip
arabic_support_dataset.zip
multi_agent_x3.txt
*.log

# Offline Evaluation Results Cache (ablation_report.json is kept for the API)
results/eval_cache.json

# Documentation & Project Specifications
README.md
arabic_support_agent_project.md
LICENSE

# IDE & OS System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
